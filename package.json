{
    "name": "@codenameryuu/adonis-lucid-filter",
    "description": "Addon for filtering Adonis JS with Lucid ORM",
    "version": "3.2.6",
    "author": "codenameryuu <leaderballon@gmail.com>",
    "license": "MIT",
    "homepage": "https://github.com/codenameryuu/adonis-lucid-filter#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/codenameryuu/adonis-lucid-filter.git"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "type": "module",
    "files": [
        "build",
        "!build/bin",
        "!build/tests"
    ],
    "exports": {
        ".": "./build/index.js",
        "./commands": "./build/commands/main.js",
        "./types/*": "./build/src/types/*.js",
        "./bindings": "./build/src/bindings/model_query_builder.js",
        "./provider": "./build/providers/lucid_filter_provider.js"
    },
    "scripts": {
        "format": "prettier --write .",
        "clean": "del-cli build",
        "precompile": "npm run clean",
        "postcompile": "npm run copy:stubs && npm run index:commands",
        "compile": "tsc",
        "build": "npm run compile",
        "copy:stubs": "copyfiles \"stubs/**/*.stub\" --up 1 build/stubs",
        "index:commands": "adonis-kit index build/commands",
        "quick:test": "NODE_DEBUG=\"adonis-lucid-filter\" node --enable-source-maps --loader=ts-node/esm bin/test.ts",
        "test": "c8 npm run quick:test",
        "typecheck": "tsc --noEmit",
        "version": "npm run build",
        "prepublishOnly": "npm run build",
        "release": "np"
    },
    "devDependencies": {
        "@adonisjs/assembler": "^8.4.0",
        "@adonisjs/core": "^7.3.4",
        "@adonisjs/lucid": "^22.4.2",
        "@adonisjs/prettier-config": "^1.5.0",
        "@adonisjs/tsconfig": "^2.0.0",
        "@japa/assert": "^4.2.0",
        "@japa/expect-type": "^2.0.4",
        "@japa/file-system": "^3.0.0",
        "@japa/runner": "^5.3.0",
        "@japa/snapshot": "^2.0.10",
        "@swc/core": "^1.15.43",
        "@types/lodash": "^4.17.24",
        "@types/node": "^26.0.1",
        "c8": "^11.0.0",
        "copyfiles": "^2.4.1",
        "del-cli": "^7.0.0",
        "knex": "^3.3.0",
        "lodash": "^4.18.1",
        "luxon": "^3.7.2",
        "np": "^11.2.1",
        "prettier": "^3.9.1",
        "reflect-metadata": "^0.2.2",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "typescript": "^6.0.3",
        "youch": "^4.1.1"
    },
    "dependencies": {
        "type-fest": "^5.7.0"
    },
    "peerDependencies": {
        "@adonisjs/core": "^7.0.0",
        "@adonisjs/lucid": "^22.0.0"
    },
    "keywords": [
        "adonisjs",
        "adonisjs-filter",
        "adonisjs-lucid",
        "adonisjs-lucid-filter",
        "adonis",
        "adonis-lucid",
        "adonis-filter",
        "adonis-lucid-filter"
    ],
    "prettier": "@adonisjs/prettier-config",
    "publishConfig": {
        "access": "public",
        "tag": "latest"
    },
    "np": {
        "message": "chore(release): %s",
        "tag": "latest",
        "branch": "master",
        "anyBranch": false
    },
    "c8": {
        "reporter": [
            "text",
            "html"
        ],
        "exclude": [
            "tests/**",
            "bin/**"
        ]
    }
}